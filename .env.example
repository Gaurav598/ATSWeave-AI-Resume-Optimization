# Database (SQLite for local; swap to Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Public site URL for SEO (sitemap, Open Graph, canonical)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Google OAuth (required). Create credentials in Google Cloud Console.
# Local callback:  http://localhost:3000/api/auth/callback/google
# Production:      https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# One-click local demo login (set false in production)
AUTH_DEMO_LOGIN="true"

# AI — gemini | openai | grok | mock
# Paste GEMINI_API_KEY and restart. Empty key falls back to the rules-based rewriter; this is not a live AI model.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
GROK_API_KEY=""
GROK_MODEL="grok-2-latest"
XAI_API_BASE="https://api.x.ai/v1"

# Production AI limits (1000+ users)
AI_RATE_LIMIT_PER_HOUR="20"
AI_RATE_LIMIT_PER_DAY="50"
AI_MAX_CONCURRENCY="8"
ATS_CHECK_LIMIT_PER_HOUR="30"

# Optional Redis / BullMQ
REDIS_URL=""

# PDFs are rendered in-process — no LaTeX toolchain or external service required.
# The .tex export is generated from the same content for use in Overleaf.
